# Supabase — copy to apps/web/.env and fill in from your project's
# Settings → API. Both values are public-safe (Row-Level Security guards data).
# Leave unset to run VisionDS fully signed-out; accounts simply won't appear.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Trace service for C++/Java (unchanged; defaults to http://localhost:8787).
# VITE_TRACE_SERVICE=http://localhost:8787
